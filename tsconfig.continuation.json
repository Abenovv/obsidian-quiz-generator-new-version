{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"types": ["node"],
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noEmit": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/continuation/**/*.ts", "src/notes/**/*.ts", "src/quality/**/*.ts", "src/feedback/**/*.ts"],
	"exclude": ["node_modules", "vendor", "preview"]
}
